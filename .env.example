# 字段参考，不是可直接使用的配置。
# 真实部署请用 `bash deploy/initialize.sh --origin <地址>` 生成 .env 与 .secrets/，
# 初始化脚本会拒绝覆盖已有文件。这里的值全部是虚构占位，不能用于生产。

# 站点对外地址。决定 Cookie 是否带 Secure：
#   - https://<域名>        → COOKIE_SECURE=true（公网/HTTPS 必须）
#   - http://127.0.0.1:18080 → COOKIE_SECURE=false（仅 SSH 隧道私密试运行）
APP_ORIGIN=https://knowledge.example.com
APP_PORT=18080
COOKIE_SECURE=true

# 首个管理员账号名。密码不写在这里：由 initialize.sh 随机生成到 .secrets/admin_password。
ADMIN_USER=admin

# 模型接入（可选）。不配置时「平台模型分析」「站内 AI 导师」会明确报错，不会用示例回答兜底。
# AI_BASE_URL 只接受 https://。密钥写到 .secrets/ai_api_key。
AI_BASE_URL=
AI_MODEL=

# 镜像标识（可选）。compose 用它给镜像打 tag，并把 commit 写进 OCI label。
APP_VERSION=0.3.1
APP_COMMIT=unknown
